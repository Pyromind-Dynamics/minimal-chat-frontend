# Backend URL (leave empty if using Vite proxy in dev mode)
VITE_BACKEND_URL=

# WebSocket URL (leave empty to auto-derive from window.location)
VITE_WS_URL=

# Session API Key (must match the one used to start agent-server)
VITE_SESSION_API_KEY=

# Dev-only JWT generator for testing different portal user_id values.
# Defaults to the agent-server APP_ENV=dev secret if omitted.
VITE_TEST_JWT_SECRET=

# LLM Configuration (passed to agent-server when creating conversations)
VITE_LLM_MODEL=gpt-4o
VITE_LLM_API_KEY=sk-your-key-here
VITE_LLM_BASE_URL=

# Note: Knowledge base path is configured on the server side via
# the PYROMIND_KNOWLEDGE_BASE_PATH environment variable.
# The frontend can also override it per-request via the `extra` field.
